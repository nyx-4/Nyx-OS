---
Checks: >-
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  misc-*,
  performance-*,
  readability-*,
  portability-*,

  -bugprone-easily-swappable-parameters,
  -misc-use-internal-linkage,
  -performance-no-int-to-ptr,
  -cppcoreguidelines-*,


WarningsAsErrors: >-
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*,
  performance-move-const-arg,
  performance-unnecessary-value-param,
  readability-duplicate-include,

HeaderFileExtensions:
  - ''
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: '.*\.(c|cxx|cpp)$'
ExcludeHeaderFilterRegex: ''
FormatStyle:     none
User:            Nyx-4
CheckOptions:
  readability-identifier-naming.ConstantCase: UPPER_CASE
  readability-identifier-naming.ClassConstantCase: UPPER_CASE
  readability-identifier-naming.ClassCase: lower_case
  readability-identifier-naming.ClassMethodCase: lower_case
  readability-identifier-naming.ClassMemberCase: lower_case
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
#   Ignore some specific names
  readability-identifier-naming.ConstantIgnoredRegexp: ^ttyS_ops$|^vt_ops$|^fb_ops$|^vga_ops$
  readability-identifier-naming.ClassIgnoredRegexp: ^ttyS$
  readability-identifier-naming.FunctionIgnoredRegexp: ^ttyS_.*$
  readability-identifier-naming.VariableIgnoredRegexp: ^ttyS1_tty$|^ttyS0$

  readability-function-size.StatementThreshold: 42
  readability-function-size.NestingThreshold: 5
  readability-magic-numbers.IgnorePowersOf2IntegerValues: true
  readability-magic-numbers.IgnoredIntegerValues: '1;2;3;4;5;6;7;10;100'
  readability-identifier-length.IgnoredVariableNames: ^fb$|^ws$
  readability-identifier-length.IgnoredParameterNames: ^fb$|^ws$
SystemHeaders:   false
...
